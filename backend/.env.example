# Copy this file to .env and fill in your values.
PORT=5000

# MongoDB connection string (local or Atlas).
# Local example:  mongodb://127.0.0.1:27017/edusphere
# Atlas example:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/edusphere
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/edusphere

# Secret used to sign JWTs — use a long random string in production.
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRE=30d

# Frontend origin (for reference).
CLIENT_URL=http://localhost:8080

# --- AWS S3 (recorded lecture video storage) ---
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_REGION=us-east-2
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=your_bucket_name

# --- Zapier webhook (optional, best-effort upload notifications) ---
ZAPIER_CALL_WEBHOOK_URL=

# --- OpenAI (study assistant chatbot) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
